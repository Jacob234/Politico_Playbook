# Politico Playbook Pipeline Configuration

# --- Gmail (NEW: OAuth, not App Password) ---
# OAuth client credentials JSON path (download from Google Cloud Console)
GOOGLE_OAUTH_CLIENT_SECRETS=~/.config/politico-pipeline/oauth_client.json
# Token cache (auto-created on first auth)
GOOGLE_OAUTH_TOKEN_PATH=~/.config/politico-pipeline/token.json

# --- Legacy IMAP (DEPRECATED — kept for v0.1-poc-single-source path only) ---
# GMAIL_ADDRESS=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_app_password_here

# --- Storage ---
RAW_EMAILS_DB=data/raw_emails.db
DATABASE_PATH=data/politico_playbook.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/playbook.log

# --- Ingestion Limits ---
MAX_EMAILS_PER_RUN=500
GMAIL_BATCH_SIZE=50

# --- Model Layer (OpenRouter, not direct Anthropic) ---
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model ID — single string change to swap providers.
# Free tier (rate-limited, dev only): tencent/hy3-preview:free
# Paid baseline: anthropic/claude-haiku-4-5
# Premium: anthropic/claude-sonnet-4-6
MODEL_ID=tencent/hy3-preview:free

# --- Optional: app referrer headers for OpenRouter analytics ---
OPENROUTER_APP_NAME=politico-pipeline
OPENROUTER_APP_URL=https://github.com/Jacob234/Politico_Playbook
